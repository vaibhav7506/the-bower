{
  "name": "the-bower",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:images": "python ./scripts/build_images.py",
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/site.css --minify",
    "build:js": "esbuild ./static/js/reservations.source.js --bundle --minify --format=iife --outfile=./static/js/reservations.js",
    "build": "npm run build:images && npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/site.css --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  }
}
